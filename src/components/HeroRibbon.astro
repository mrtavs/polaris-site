---
// Home hero artwork: an abstract ribbon of hairline strands rising to the right, silver warming to brass.
// Generated by scripts/make_ribbon.py into public/images/ribbon.svg.
---
<img class="hero-ribbon" src="/images/ribbon.svg" alt="" width="1600" height="1000" fetchpriority="high" />
<style>
  .hero-ribbon { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 62% 60%; z-index: -2; pointer-events: none; }
  @media (max-width: 760px) { .hero-ribbon { inset: auto 0 0 0; height: 260px; object-position: 58% 78%; } }
</style>
