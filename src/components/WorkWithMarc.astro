---
import { BOOKING_URL, ADVISORY_URL } from '../config/legal';
interface Props { topic?: string }
const { topic = 'this thesis' } = Astro.props;
---
<aside class="work" aria-labelledby="work-head">
  <div class="work-inner">
    <h2 id="work-head">Work with Marc</h2>
    <p>
      If you are building, backing or regulating a company in the territory {topic} covers, Marc advises boards
      and founders on go to market, deals and credibility with banks, regulators and institutions. Advisory and
      consultancy are contracted through Bluesphere Solutions.
    </p>
    <div class="actions">
      <a class="btn primary plausible-event-name=Book+Click plausible-event-location=thesis" href={BOOKING_URL}>Book a 20 minute call</a>
      <a class="btn" href={ADVISORY_URL}>See how Marc works with companies</a>
    </div>
  </div>
</aside>
