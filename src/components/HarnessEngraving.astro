---
// Home hero graphic: the harness, drawn simply. Six fine rings around the Polaris star, one per layer of the harness
// from Investing in the Harness. Evaluation and Identity, the investable layers in the thesis, are brass.
const C = 600; // centre in a 1200 unit square
const layers = [
  { name: 'Context', r: 120, key: false },
  { name: 'Policy', r: 190, key: false },
  { name: 'Process', r: 262, key: false },
  { name: 'Evaluation', r: 336, key: true },
  { name: 'Feedback', r: 412, key: false },
  { name: 'Identity', r: 490, key: true },
];
// Labels sit on each ring, all starting on the same bearing in the upper left, reading upright.
const ringPath = (r: number) => {
  const t0 = ((305 - 90) * Math.PI) / 180;
  const t1 = t0 + Math.PI * 0.4;
  const p = (t: number) => `${(C + r * Math.cos(t)).toFixed(1)} ${(C + r * Math.sin(t)).toFixed(1)}`;
  return `M${p(t0)} A${r} ${r} 0 0 1 ${p(t1)}`;
};
---
<figure class="harness" aria-label="The harness: six layers around a model">
  <svg class="harness-svg" viewBox="0 0 1200 1200" aria-hidden="true">
    <defs>
      <radialGradient id="hcore" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fff3d6" stop-opacity=".75" />
        <stop offset=".22" stop-color="#e3c78f" stop-opacity=".22" />
        <stop offset="1" stop-color="#cfae6d" stop-opacity="0" />
      </radialGradient>
      {layers.map((l, i) => <path id={`hl${i}`} d={ringPath(l.r)} fill="none" />)}
    </defs>
    {layers.map((l) => (
      <circle cx={C} cy={C} r={l.r} fill="none"
        stroke={l.key ? '#cfae6d' : '#a9b6c6'}
        stroke-opacity={l.key ? 0.85 : 0.22}
        stroke-width={l.key ? 1.4 : 1} />
    ))}
    {layers.map((l, i) => (
      <text class={l.key ? 'harness-label key' : 'harness-label'} dy="-10"><textPath href={`#hl${i}`}>{l.name}</textPath></text>
    ))}
    <circle cx={C} cy={C} r="80" fill="url(#hcore)" />
    <path d={`M${C} ${C - 34}L${C + 4} ${C - 4}L${C + 34} ${C}L${C + 4} ${C + 4}L${C} ${C + 34}L${C - 4} ${C + 4}L${C - 34} ${C}L${C - 4} ${C - 4}Z`} fill="#fbf0d2" />
  </svg>
</figure>

<style>
  .harness { margin: 0; position: absolute; z-index: -2; pointer-events: none;
    width: clamp(780px, 72vw, 1120px); top: 50%; right: clamp(-300px, -15vw, -120px); transform: translateY(-50%); }
  .harness-svg { display: block; width: 100%; height: auto; aspect-ratio: 1; }
  .harness-label { font: 500 14px 'Instrument Sans', system-ui, sans-serif; fill: #8f9db0; letter-spacing: 0.06em; }
  .harness-label.key { fill: #e2c58a; }
  @media (max-width: 760px) {
    .harness { position: relative; width: 118vw; top: auto; right: auto; left: 50%; transform: translateX(-50%); margin-top: -14vw; margin-bottom: -10vw; }
  }
</style>
