---
import '../styles/site.css';
import { LEGAL_OWNER, LEGAL_COMPANY_NO, LEGAL_URL, BLUESPHERE_ORG_ID, BOOKING_URL, ADVISORY_URL } from '../config/legal';

interface Props {
  title: string;
  description: string;
  path: string;
  extraSchema?: Record<string, unknown>[];
  ogType?: string;
  darkHeader?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  noCanonical?: boolean;
}

const { title, description, path, extraSchema = [], ogType = 'website', darkHeader = false } = Astro.props;
const OG_BY_PATH: [string, string, string][] = [
  ['/theses/investing-in-the-harness/', '/og-harness.png', 'Investing in the Harness, the Polaris investment thesis by Marc Taverner'],
  ['/theses/agents-of-sovereignty/', '/og-sovereignty.png', 'Agents of Sovereignty, an essay by Marc Taverner, 2026 to 2031'],
  ['/fund/', '/og-fund.png', 'Polaris Fund, private angel investment'],
  ['/council/', '/og-council.png', 'The Polaris Council, Speaker\'s House, Westminster, 23 April 2026'],
  ['/archive/', '/og-archive.png', 'Polaris archive, the 2025 thesis and papers'],
];
const ogMatch = OG_BY_PATH.find(([prefix]) => path.startsWith(prefix));
const ogImage = Astro.props.ogImage ?? ogMatch?.[1] ?? '/og.png';
const ogImageAlt = Astro.props.ogImageAlt ?? ogMatch?.[2] ?? 'Polaris Group, where value is moving in applied AI';
const site = 'https://polarisglobal.io';
const canonical = new URL(path, site).href;
const fullTitle = path === '/' ? title : `${title} | Polaris Group`;

const PERSON_ID = 'https://marctaverner.com/#person';
const ORG_ID = 'https://polarisglobal.io/#organization';

const graph = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: 'Polaris Group',
    alternateName: 'Polaris Global',
    url: `${site}/`,
    description:
      'Polaris Group focuses on where value is moving in applied AI, carefully selects start ups for private angel investment and convenes the private and public sectors through the Polaris Council.',
    founder: { '@id': PERSON_ID },
    parentOrganization: { '@id': BLUESPHERE_ORG_ID },
    subOrganization: {
      '@type': 'Organization',
      '@id': `${site}/#council`,
      name: 'Polaris Council',
      url: `${site}/council/`,
    },
  },
  {
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    url: `${site}/`,
    name: 'Polaris Group',
    publisher: { '@id': ORG_ID },
    inLanguage: 'en-GB',
  },
  {
    '@type': 'Person',
    '@id': PERSON_ID,
    name: 'Marc Taverner',
    url: 'https://marctaverner.com/',
  },
  ...extraSchema,
];
const schema = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });

const nav = [
  { href: '/theses/', label: 'Theses' },
  { href: '/fund/', label: 'Fund' },
  { href: '/council/', label: 'Council' },
  { href: '/archive/', label: 'Archive' },
  { href: '/contact/', label: 'Contact' },
];
const current = (href: string) => path.startsWith(href);
// Draft builds are noindex. Set PUBLIC_INDEXABLE=true in Netlify only at go live (Site Standards Checklist v1, section 3).
const isLive = import.meta.env.PUBLIC_INDEXABLE === 'true' || import.meta.env.PUBLIC_GO_LIVE === 'true';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="preload" href="/fonts/newsreader-opsz.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/instrument-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {!Astro.props.noCanonical && <link rel="canonical" href={canonical} />}
    {!Astro.props.noCanonical && <link rel="alternate" type="text/markdown" href={path === '/' ? '/index.md' : path.replace(/\/$/, '.md')} />}
    <meta name="author" content="Marc Taverner" />
    {isLive
      ? <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      : <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b1626" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!Astro.props.noCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="Polaris Group" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={`${site}${ogImage}`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}${ogImage}`} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full text for AI tools" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI tools" />
    <script type="application/ld+json" set:html={schema} />
    {isLive && (
      <>
        <script async src="https://plausible.io/js/pa-LtFYlpL-uWqyt_zzAbEl4.js"></script>
        <script is:inline>window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()</script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class={darkHeader ? "masthead masthead-dark" : "masthead"}>
      <div class="wrap masthead-inner">
        <a class="brand" href="/" aria-label="Polaris Group home">
          <svg class="brand-mark" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 1.5 13.6 10.4 22.5 12 13.6 13.6 12 22.5 10.4 13.6 1.5 12 10.4 10.4Z" />
          </svg>
          <span>Polaris Group</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Polaris Group</p>
          <p class="footer-desc">
            Polaris Group focuses on where value is moving in applied AI, carefully selects start ups for private angel
            investment and convenes the private and public sectors through the Polaris Council.
          </p>
        </div>
        <div>
          <p class="footer-head">Read</p>
          <ul>
            <li><a href="/theses/investing-in-the-harness/">Investing in the Harness</a></li>
            <li><a href="/theses/agents-of-sovereignty/">Agents of Sovereignty</a></li>
            <li><a href="/archive/">Archive</a></li>
            <li><a href="/fund/">Polaris Fund</a></li>
          </ul>
        </div>
        <div>
          <p class="footer-head">Marc Taverner</p>
          <p class="footer-desc">Go to market and board advisor to web3, digital asset, fintech and AI companies.</p>
          <ul>
            <li><a href="https://marctaverner.com/">About Marc</a></li>
            <li><a href={ADVISORY_URL}>Advisory through Bluesphere</a></li>
            <li><a href={BOOKING_URL} class="plausible-event-name=Book+Click plausible-event-location=footer">Book a 20 minute call</a></li>
            <li><a href="https://www.linkedin.com/in/marctaverner/">LinkedIn</a></li>
          </ul>
        </div>
      </div>
      <div class="wrap footer-base">
        <p>London, working globally. <a href="mailto:marc@bluespheresolutions.co.uk">marc@bluespheresolutions.co.uk</a></p>
        <p>Polaris Group is owned by {LEGAL_OWNER}, company {LEGAL_COMPANY_NO}. <a href={LEGAL_URL}>Legal and privacy</a></p>
      </div>
    </footer>
  </body>
</html>
