---
import Base from './Base.astro';
import WorkWithMarc from '../components/WorkWithMarc.astro';

interface Props {
  title: string;
  subtitle?: string;
  kicker: string;
  description: string;
  path: string;
  dateLabel: string;
  datePublished: string;
  dateModified?: string;
  pdf?: string;
  related?: { href: string; label: string }[];
  topic?: string;
  archived?: boolean;
  org?: string;
  extraLine?: string;
  seoTitle?: string;
}

const {
  title, subtitle, kicker, description, path, dateLabel, datePublished,
  dateModified, pdf, related = [], topic, archived = false, org, extraLine, seoTitle,
} = Astro.props;

const url = new URL(path, 'https://polarisglobal.io').href;
// Google wants a full ISO 8601 datetime with time zone; dates are given as YYYY-MM-DD (London time).
const withZone = (d: string) => {
  if (/T\d\d:/.test(d)) return d;
  const probe = new Date(`${d}T12:00:00Z`);
  const london = new Date(probe.toLocaleString('en-US', { timeZone: 'Europe/London' }));
  const utc = new Date(probe.toLocaleString('en-US', { timeZone: 'UTC' }));
  const off = Math.round((london.getTime() - utc.getTime()) / 3600000);
  return `${d}T09:00:00+0${off}:00`;
};
const ogFile = path.startsWith('/theses/investing-in-the-harness/') ? '/og-harness.png'
  : path.startsWith('/theses/agents-of-sovereignty/') ? '/og-sovereignty.png'
  : path.startsWith('/archive/') ? '/og-archive.png' : '/og.png';
const crumbs = path.startsWith('/archive/')
  ? [['Home', '/'], ['Archive', '/archive/']] : [['Home', '/'], ['Theses', '/theses/']];
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [...crumbs, [title, path]].map(([name, href], i) => ({
    '@type': 'ListItem', position: i + 1, name, item: new URL(href, 'https://polarisglobal.io').href,
  })),
};
const article = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: subtitle && `${title}: ${subtitle}`.length <= 110 ? `${title}: ${subtitle}` : title,
  ...(subtitle && `${title}: ${subtitle}`.length > 110 ? { alternativeHeadline: subtitle } : {}),
  description,
  url,
  mainEntityOfPage: url,
  datePublished: withZone(datePublished),
  dateModified: withZone(dateModified ?? datePublished),
  inLanguage: 'en-GB',
  image: { '@type': 'ImageObject', url: `https://polarisglobal.io${ogFile}`, width: 1200, height: 630 },
  author: { '@id': 'https://marctaverner.com/#person', '@type': 'Person', name: 'Marc Taverner', url: 'https://marctaverner.com/' },
  publisher: { '@id': 'https://polarisglobal.io/#organization' },
  isPartOf: { '@id': 'https://polarisglobal.io/#website' },
  ...(pdf ? { encoding: { '@type': 'MediaObject', encodingFormat: 'application/pdf', contentUrl: new URL(pdf, 'https://polarisglobal.io').href } } : {}),
  ...(archived ? { creativeWorkStatus: 'Archived' } : {}),
};
---
<Base updated={dateModified ?? datePublished} title={seoTitle ?? (subtitle ? `${title}: ${subtitle}` : title)} description={description} path={path} extraSchema={[article, breadcrumb]} ogType="article">
  <article>
    <header class="article-head wrap">
      <p class="kicker">{kicker}</p>
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <p class="byline">
        <span>By <a href="https://marctaverner.com/" rel="author">Marc Taverner</a>{org && `, ${org}`}</span>
        <span>{dateLabel}</span>
        {extraLine && <span>{extraLine}</span>}
      </p>
      <div class="article-tools">
        {pdf && <a class="btn" href={pdf} download>Download the PDF</a>}
        {related.map((r) => <a class="btn" href={r.href}>{r.label}</a>)}
      </div>
      <slot name="note" />
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
  <WorkWithMarc topic={topic} />
</Base>
